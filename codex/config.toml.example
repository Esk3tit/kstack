notify = ["/Users/khaiphan/.codex/computer-use/Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient", "turn-ended"]
model = "gpt-6.2-sol"
model_reasoning_effort = "high"
service_tier = "default"

[mcp_servers.railway]
url = "https://mcp.railway.com"

[mcp_servers.node_repl]
args = []
command = "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node_repl"
env_vars = ["BROWSER_USE_ACCESS_EXECUTOR_ID", "BROWSER_USE_ACCESS_PIPE_PATH", "BROWSER_USE_ACCESS_VERIFYING_IDENTITY"]
startup_timeout_sec = 120

[mcp_servers.node_repl.env]
NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS = "1000"
NODE_REPL_NODE_MODULE_DIRS = "/Applications/ChatGPT.app/Contents/Resources/cua_node/lib/node_modules"
NODE_REPL_NODE_PATH = "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node"
NODE_REPL_TRUSTED_CODE_PATHS = "/Users/khaiphan/.codex:/Applications/ChatGPT.app/Contents/Resources/cua_node/lib/node_modules"
CODEX_HOME = "/Users/khaiphan/.codex"
BROWSER_USE_AVAILABLE_BACKENDS = "chrome,iab,mcpapps"
BROWSER_USE_TINYSKY_ENABLED = "1"
NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER = ""
NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME = ""
NODE_REPL_INSTRUCTIONS_USE_CASE_COMPUTER_USE = ""
BROWSER_USE_CODEX_APP_BUILD_FLAVOR = "prod"
BROWSER_USE_CODEX_APP_VERSION = "26.1111.21308"
NODE_REPL_TRUSTED_SERVICES = '{"browser":"/Users/khaiphan/.codex/plugins/cache/openai-bundled/browser/26.1111.21308/scripts/browser-service.mjs","sky":"@oai/sky/service"}'
SKY_CUA_SERVICE_PATH = "/Users/khaiphan/.codex/computer-use/Codex Computer Use.app"
CODEX_CLI_PATH = "/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex"

[mcp_servers.appwrite]
enabled = false
command = "uvx mcp-server-appwrite --users"

[mcp_servers.appwrite.env]
APPWRITE_API_KEY = "APPWRITE_API_KEY_REDACTED_SET_YOUR_OWN"
APPWRITE_ENDPOINT = "https://sfo.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID = "APPWRITE_PROJECT_ID_REDACTED_SET_YOUR_OWN"

[mcp_servers.appwrite-docs]
enabled = false
command = "npx mcp-remote https://mcp-for-docs.appwrite.io"

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"

[mcp_servers.context-mode]
omit_tools_from = ["deferred"]
default_tools_approval_mode = "approve"
command = "/opt/homebrew/opt/node/bin/node"
args = ["/opt/homebrew/lib/node_modules/context-mode/server.mjs", "--agent", "codex"]

[desktop]
followUpQueueMode = "steer"
external-agent-import-sync-enabled = true
conversationDetailMode = "STEPS_COMMANDS"
ambient-suggestions-enabled = true

[desktop.external-agent-import-sync-item-types]
SESSIONS = false
SKILLS = "original"
PLUGINS = "original"
MCP_SERVER_CONFIG = "original"
HOOKS = "original"

[marketplaces.openai-bundled]
source_type = "local"
source = "/Users/khaiphan/.codex/.tmp/bundled-marketplaces/openai-bundled"

[marketplaces.openai-primary-runtime]
source_type = "local"
source = "/Users/khaiphan/.cache/codex-runtimes/codex-primary-runtime/plugins/openai-primary-runtime"

[marketplaces.claude-plugins-official]
source_type = "git"
source = "https://github.com/anthropics/claude-plugins-official.git"

[marketplaces.context-mode]
source_type = "git"
source = "https://github.com/mksglu/context-mode.git"
ref = "v2.1.10"

[marketplaces.openai-codex]
source_type = "git"
source = "https://github.com/openai/codex-plugin-cc.git"

[marketplaces.mattpocock]
source_type = "git"
source = "https://github.com/mattpocock/skills.git"

